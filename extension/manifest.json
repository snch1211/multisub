{
  "manifest_version": 3,
  "name": "MultiSub",
  "version": "1.1.0",
  "description": "Netflix 雙語字幕：疊上 Netflix 官方字幕、用 AI 翻譯，或在難字旁標上意思。",
  "permissions": ["storage", "nativeMessaging"],
  "host_permissions": ["*://*.netflix.com/*"],
  "background": {
    "scripts": ["shared.js", "background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["*://*.netflix.com/*"],
      "js": ["shared.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.netflix.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["*://*.netflix.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MultiSub"
  }
}
