// Local.xcconfig — machine-local overrides for MultiSub.xcconfig (gitignored).
//
// 1. Copy this file to Local.xcconfig (same folder).
// 2. Fill in your Team ID and a bundle ID you own.
//
// A free Personal Team works for running locally. Your Team ID is shown in
// Xcode ▸ Settings ▸ Accounts, or at developer.apple.com/account ▸ Membership.

DEVELOPMENT_TEAM = YOUR_TEAM_ID
MULTISUB_BUNDLE_ID = com.yourname.multisub
